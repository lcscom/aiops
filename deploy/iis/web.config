<?xml version="1.0" encoding="utf-8"?>
<!--
  (선택) IIS 리버스 프록시 — 사내 표준이 IIS(443, Windows 인증서 저장소·SSO)일 때만 사용.
  기본 권장은 AIOps 서비스가 직접 HTTPS(:8630)를 서빙하는 구성(scripts\windows\export-cert.ps1).

  사전 조건(서버 관리자/관리자 PowerShell):
    Install-WindowsFeature Web-Server, Web-WebSockets
    URL Rewrite 2.1 + Application Request Routing 3.0 설치 후:
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /enabled:"True" /preserveHostHeader:"True" /reverseRewriteHostInResponseHeaders:"False" /commit:apphost
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /responseBufferLimit:"0" /commit:apphost      (SSE·스트리밍 버퍼링 해제)
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
  IIS 사이트(443 바인딩, 사내 CA 인증서) 루트에 이 파일을 두고, config.yaml 은
    server.host: 127.0.0.1   server.tls.enabled: false   server.trusted_proxies: 127.0.0.1
-->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="vcf-aiops" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8630/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
