# VCF AIops 무인 배포 설정 — 복사해서 값만 채운 뒤:  sudo bash deploy.sh --env deploy.env --yes
# 비워 둔 항목은 기본값. 이 파일에는 PAIS 키가 들어가므로 배포 뒤 지우거나 권한을 600 으로.

FQDN=aiops.corp.local            # 이 서버 이름(인증서·장비 syslog 대상·알림 링크) — DNS A 레코드 권장
NTP=10.0.0.1,10.0.0.2            # 장비들과 같은 NTP(로그 시각 상관 분석에 필수)
PAIS_URL=                        # VMware Private AI Services(OpenAI 호환) 예: https://pais.corp.local/v1  — 비우면 규칙 탐지만
PAIS_KEY=
LLM_MODEL=google/gemma-4-31B-it  # PAIS /v1/models 의 id
PORT=8630                        # 웹·API·에이전트·Redfish 수신 포트
RETENTION_DAYS=7                 # 원본 로그 보존 일수
ENABLE_FIREWALL=0                # 1 = ufw 켜기(22·8630·514·6514·162 허용), 0 = 규칙만 추가
CERT=                            # 사내 CA 인증서(PEM) 경로 — 비우면 자체 서명(나중에 교체 가능)
KEY=
OFFLINE_DIR=                     # 망분리: build-offline 번들을 푼 폴더
