<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VCF AIops" android:textColor="#B8C4CC" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8A96A0" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DCE3E8" android:textSize="12sp" android:maxLines="2" />
    <TextView android:id="@+id/w_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9FD3F0" android:textSize="12sp" android:maxLines="1" android:paddingTop="2dp" />
</LinearLayout>
